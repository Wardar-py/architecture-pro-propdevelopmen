          <mxGeometry height="30" width="940" y="30" as="geometry" />
        </mxCell>
        <mxCell id="i45gL9GsNu5qXC94Cn_V-109" parent="i45gL9GsNu5qXC94Cn_V-107" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Потеря (критический): утрата ключей может привести к необратимой потере зашифрованных данных (например, базы с персональными данными)." vertex="1">
          <mxGeometry height="30" width="940" y="60" as="geometry" />
        </mxCell>
        <mxCell id="i45gL9GsNu5qXC94Cn_V-110" parent="i45gL9GsNu5qXC94Cn_V-107" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Искажение (критический): несанкционированное изменение конфигураций безопасности создаёт уязвимости, эксплуатируемые злоумышленниками." vertex="1">
          <mxGeometry height="30" width="940" y="90" as="geometry" />
        </mxCell>
        <mxCell id="i45gL9GsNu5qXC94Cn_V-111" parent="i45gL9GsNu5qXC94Cn_V-107" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="Некачественные данные (значительный): неточная документация по управлению секретами затрудняет оперативное реагирование на инциденты." vertex="1">
          <mxGeometry height="30" width="940" y="120" as="geometry" />
        </mxCell>
